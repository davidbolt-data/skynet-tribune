{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skynet-tribune",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "HEADLINES",
      "id": "2252e050964e45f0b7edc233759df0c8"
    }
  ]
}
